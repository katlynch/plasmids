dc113/dt=theta*((beta*12^gamma*f1*c112-kappa*13*c113)-(beta*13^gamma*f1*c113-kappa*14*c114))
dc114/dt=theta*((beta*13^gamma*f1*c113-kappa*14*c114)-(beta*14^gamma*f1*c114-kappa*15*c115))
dc115/dt=theta*((beta*14^gamma*f1*c114-kappa*15*c115)-(beta*15^gamma*f1*c115-kappa*16*c116))
dc116/dt=theta*((beta*15^gamma*f1*c115-kappa*16*c116)-(beta*16^gamma*f1*c116-kappa*17*c117))
dc117/dt=theta*((beta*16^gamma*f1*c116-kappa*17*c117)-(beta*17^gamma*f1*c117-kappa*18*c118))
dc118/dt=theta*((beta*17^gamma*f1*c117-kappa*18*c118)-(beta*18^gamma*f1*c118-kappa*19*c119))
dc119/dt=theta*((beta*18^gamma*f1*c118-kappa*19*c119)-(beta*19^gamma*f1*c119-kappa*20*c120))
dc120/dt=theta*((beta*19^gamma*f1*c119-kappa*20*c120)-(beta*20^gamma*f1*c120-kappa*21*c121))
dc121/dt=theta*((beta*20^gamma*f1*c120-kappa*21*c121)-(beta*21^gamma*f1*c121-kappa*22*c122))
dc122/dt=theta*((beta*21^gamma*f1*c121-kappa*22*c122)-(beta*22^gamma*f1*c122-kappa*23*c123))
dc123/dt=theta*((beta*22^gamma*f1*c122-kappa*23*c123)-(beta*23^gamma*f1*c123-kappa*24*c124))
dc124/dt=theta*((beta*23^gamma*f1*c123-kappa*24*c124)-(beta*24^gamma*f1*c124-kappa*25*c125))
dc125/dt=theta*((beta*24^gamma*f1*c124-kappa*25*c125)-(beta*25^gamma*f1*c125-kappa*26*c126))
dc126/dt=theta*((beta*25^gamma*f1*c125-kappa*26*c126)-(beta*26^gamma*f1*c126-kappa*27*c127))
dc127/dt=theta*((beta*26^gamma*f1*c126-kappa*27*c127)-(beta*27^gamma*f1*c127-kappa*28*c128))
dc128/dt=theta*((beta*27^gamma*f1*c127-kappa*28*c128)-(beta*28^gamma*f1*c128-kappa*29*c129))
dc129/dt=theta*((beta*28^gamma*f1*c128-kappa*29*c129)-(beta*29^gamma*f1*c129-kappa*30*c130))
dc130/dt=theta*((beta*29^gamma*f1*c129-kappa*30*c130)-(beta*30^gamma*f1*c130-kappa*31*c131))
dc131/dt=theta*((beta*30^gamma*f1*c130-kappa*31*c131)-(beta*31^gamma*f1*c131-kappa*32*c132))
dc132/dt=theta*((beta*31^gamma*f1*c131-kappa*32*c132)-(beta*32^gamma*f1*c132-kappa*33*c133))
dc133/dt=theta*((beta*32^gamma*f1*c132-kappa*33*c133)-(beta*33^gamma*f1*c133-kappa*34*c134))
dc134/dt=theta*((beta*33^gamma*f1*c133-kappa*34*c134)-(beta*34^gamma*f1*c134-kappa*35*c135))
dc135/dt=theta*((beta*34^gamma*f1*c134-kappa*35*c135)-(beta*35^gamma*f1*c135-kappa*36*c136))
dc136/dt=theta*((beta*35^gamma*f1*c135-kappa*36*c136)-(beta*36^gamma*f1*c136-kappa*37*c137))
dc137/dt=theta*((beta*36^gamma*f1*c136-kappa*37*c137)-(beta*37^gamma*f1*c137-kappa*38*c138))
dc138/dt=theta*((beta*37^gamma*f1*c137-kappa*38*c138)-(beta*38^gamma*f1*c138-kappa*39*c139))
dc139/dt=theta*((beta*38^gamma*f1*c138-kappa*39*c139)-(beta*39^gamma*f1*c139-kappa*40*c140))
dc140/dt=theta*(beta*39^gamma*f1*c139-kappa*40*c140)

dc22/dt=theta*((0.5*beta*f2^2-2*kappa*c22)-(beta*2^gamma*f2*c22-kappa*3*c23))
dc23/dt=theta*((beta*2^gamma*f2*c22-kappa*3*c23)-(beta*3^gamma*f2*c23-kappa*4*c24))
dc24/dt=theta*((beta*3^gamma*f2*c23-kappa*4*c24)-(beta*4^gamma*f2*c24-kappa*5*c25))
dc25/dt=theta*((beta*4^gamma*f2*c24-kappa*5*c25)-(beta*5^gamma*f2*c25-kappa*6*c26))
dc26/dt=theta*((beta*5^gamma*f2*c25-kappa*6*c26)-(beta*6^gamma*f2*c26-kappa*7*c27))
dc27/dt=theta*((beta*6^gamma*f2*c26-kappa*7*c27)-(beta*7^gamma*f2*c27-kappa*8*c28))
dc28/dt=theta*((beta*7^gamma*f2*c27-kappa*8*c28)-(beta*8^gamma*f2*c28-kappa*9*c29))
dc29/dt=theta*((beta*8^gamma*f2*c28-kappa*9*c29)-(beta*9^gamma*f2*c29-kappa*10*c210))
dc210/dt=theta*((beta*9^gamma*f2*c29-kappa*10*c210)-(beta*10^gamma*f2*c210-kappa*11*c211))
dc211/dt=theta*((beta*10^gamma*f2*c210-kappa*11*c211)-(beta*11^gamma*f2*c211-kappa*12*c212))
dc212/dt=theta*((beta*11^gamma*f2*c211-kappa*12*c212)-(beta*12^gamma*f2*c212-kappa*13*c213))
