dc221/dt=theta*((beta*20^gamma*f2*c220-kappa*21*c221)-(beta*21^gamma*f2*c221-kappa*22*c222))
dc222/dt=theta*((beta*21^gamma*f2*c221-kappa*22*c222)-(beta*22^gamma*f2*c222-kappa*23*c223))
dc223/dt=theta*((beta*22^gamma*f2*c222-kappa*23*c223)-(beta*23^gamma*f2*c223-kappa*24*c224))
dc224/dt=theta*((beta*23^gamma*f2*c223-kappa*24*c224)-(beta*24^gamma*f2*c224-kappa*25*c225))
dc225/dt=theta*((beta*24^gamma*f2*c224-kappa*25*c225)-(beta*25^gamma*f2*c225-kappa*26*c226))
dc226/dt=theta*((beta*25^gamma*f2*c225-kappa*26*c226)-(beta*26^gamma*f2*c226-kappa*27*c227))
dc227/dt=theta*((beta*26^gamma*f2*c226-kappa*27*c227)-(beta*27^gamma*f2*c227-kappa*28*c228))
dc228/dt=theta*((beta*27^gamma*f2*c227-kappa*28*c228)-(beta*28^gamma*f2*c228-kappa*29*c229))
dc229/dt=theta*((beta*28^gamma*f2*c228-kappa*29*c229)-(beta*29^gamma*f2*c229-kappa*30*c230))
dc230/dt=theta*((beta*29^gamma*f2*c229-kappa*30*c230)-(beta*30^gamma*f2*c230-kappa*31*c231))
dc231/dt=theta*((beta*30^gamma*f2*c230-kappa*31*c231)-(beta*31^gamma*f2*c231-kappa*32*c232))
dc232/dt=theta*((beta*31^gamma*f2*c231-kappa*32*c232)-(beta*32^gamma*f2*c232-kappa*33*c233))
dc233/dt=theta*((beta*32^gamma*f2*c232-kappa*33*c233)-(beta*33^gamma*f2*c233-kappa*34*c234))
dc234/dt=theta*((beta*33^gamma*f2*c233-kappa*34*c234)-(beta*34^gamma*f2*c234-kappa*35*c235))
dc235/dt=theta*((beta*34^gamma*f2*c234-kappa*35*c235)-(beta*35^gamma*f2*c235-kappa*36*c236))
