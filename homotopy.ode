# homotopy.ode  (auto-generated, N=40)
# State: DeltaF=f1-f2, bvar1, bvar2, c1j, c2j (j=2..N)

# Conservation and monomer reconstruction
csum1=2*c12+3*c13+4*c14+5*c15+6*c16+7*c17+8*c18+9*c19+10*c110+11*c111+12*c112+13*c113+14*c114+15*c115+16*c116+17*c117+18*c118+19*c119+20*c120+21*c121+22*c122+23*c123+24*c124+25*c125+26*c126+27*c127+28*c128+29*c129+30*c130+31*c131+32*c132+33*c133+34*c134+35*c135+36*c136+37*c137+38*c138+39*c139+40*c140

csum2=2*c22+3*c23+4*c24+5*c25+6*c26+7*c27+8*c28+9*c29+10*c210+11*c211+12*c212+13*c213+14*c214+15*c215+16*c216+17*c217+18*c218+19*c219+20*c220+21*c221+22*c222+23*c223+24*c224+25*c225+26*c226+27*c227+28*c228+29*c229+30*c230+31*c231+32*c232+33*c233+34*c234+35*c235+36*c236+37*c237+38*c238+39*c239+40*c240

SumF=Ntot-bvar1-bvar2-csum1-csum2
f1=(SumF+DeltaF)/2
f2=(SumF-DeltaF)/2


# Partial sums for DeltaF equation
pg1=2^gamma*c12+3^gamma*c13+4^gamma*c14+5^gamma*c15+6^gamma*c16+7^gamma*c17+8^gamma*c18+9^gamma*c19+10^gamma*c110+11^gamma*c111+12^gamma*c112+13^gamma*c113+14^gamma*c114+15^gamma*c115+16^gamma*c116+17^gamma*c117+18^gamma*c118+19^gamma*c119+20^gamma*c120+21^gamma*c121+22^gamma*c122+23^gamma*c123+24^gamma*c124+25^gamma*c125+26^gamma*c126+27^gamma*c127+28^gamma*c128+29^gamma*c129+30^gamma*c130+31^gamma*c131+32^gamma*c132+33^gamma*c133+34^gamma*c134+35^gamma*c135+36^gamma*c136+37^gamma*c137+38^gamma*c138+39^gamma*c139
pk1=3*c13+4*c14+5*c15+6*c16+7*c17+8*c18+9*c19+10*c110+11*c111+12*c112+13*c113+14*c114+15*c115+16*c116+17*c117+18*c118+19*c119+20*c120+21*c121+22*c122+23*c123+24*c124+25*c125+26*c126+27*c127+28*c128+29*c129+30*c130+31*c131+32*c132+33*c133+34*c134+35*c135+36*c136+37*c137+38*c138+39*c139+40*c140
pg2=2^gamma*c22+3^gamma*c23+4^gamma*c24+5^gamma*c25+6^gamma*c26+7^gamma*c27+8^gamma*c28+9^gamma*c29+10^gamma*c210+11^gamma*c211+12^gamma*c212+13^gamma*c213+14^gamma*c214+15^gamma*c215+16^gamma*c216+17^gamma*c217+18^gamma*c218+19^gamma*c219+20^gamma*c220+21^gamma*c221+22^gamma*c222+23^gamma*c223+24^gamma*c224+25^gamma*c225+26^gamma*c226+27^gamma*c227+28^gamma*c228+29^gamma*c229+30^gamma*c230+31^gamma*c231+32^gamma*c232+33^gamma*c233+34^gamma*c234+35^gamma*c235+36^gamma*c236+37^gamma*c237+38^gamma*c238+39^gamma*c239
pk2=3*c23+4*c24+5*c25+6*c26+7*c27+8*c28+9*c29+10*c210+11*c211+12*c212+13*c213+14*c214+15*c215+16*c216+17*c217+18*c218+19*c219+20*c220+21*c221+22*c222+23*c223+24*c224+25*c225+26*c226+27*c227+28*c228+29*c229+30*c230+31*c231+32*c232+33*c233+34*c234+35*c235+36*c236+37*c237+38*c238+39*c239+40*c240

# Bulk variables from asymmetry model (freeze at theta=1)
dbvar1/dt=(1-theta)*(beta*f1*(f1+bvar1^gamma)-kappa*bvar1)
dbvar2/dt=(1-theta)*(beta*f2*(f2+bvar2^gamma)-kappa*bvar2)

# Cluster distribution equations (theta-scaled)
dc12/dt=theta*((0.5*beta*f1^2-2*kappa*c12)-(beta*2^gamma*f1*c12-kappa*3*c13))
dc13/dt=theta*((beta*2^gamma*f1*c12-kappa*3*c13)-(beta*3^gamma*f1*c13-kappa*4*c14))
dc14/dt=theta*((beta*3^gamma*f1*c13-kappa*4*c14)-(beta*4^gamma*f1*c14-kappa*5*c15))
dc15/dt=theta*((beta*4^gamma*f1*c14-kappa*5*c15)-(beta*5^gamma*f1*c15-kappa*6*c16))
dc16/dt=theta*((beta*5^gamma*f1*c15-kappa*6*c16)-(beta*6^gamma*f1*c16-kappa*7*c17))
dc17/dt=theta*((beta*6^gamma*f1*c16-kappa*7*c17)-(beta*7^gamma*f1*c17-kappa*8*c18))
dc18/dt=theta*((beta*7^gamma*f1*c17-kappa*8*c18)-(beta*8^gamma*f1*c18-kappa*9*c19))
dc19/dt=theta*((beta*8^gamma*f1*c18-kappa*9*c19)-(beta*9^gamma*f1*c19-kappa*10*c110))
dc110/dt=theta*((beta*9^gamma*f1*c19-kappa*10*c110)-(beta*10^gamma*f1*c110-kappa*11*c111))
dc111/dt=theta*((beta*10^gamma*f1*c110-kappa*11*c111)-(beta*11^gamma*f1*c111-kappa*12*c112))
