dc239/dt=theta*((beta*38^gamma*f2*c238-kappa*39*c239)-(beta*39^gamma*f2*c239-kappa*40*c240))
dc240/dt=theta*(beta*39^gamma*f2*c239-kappa*40*c240)

# DeltaF = f1-f2 equation (d(DeltaF)/dt = df1/dt - df2/dt)
dDeltaF/dt=-((1-theta)*(beta*f1*(f1+bvar1^gamma)-kappa*bvar1)-(1-theta)*(beta*f2*(f2+bvar2^gamma)-kappa*bvar2))-theta*(beta*f1^2-4*kappa*c12+beta*f1*pg1-kappa*pk1-beta*f2^2+4*kappa*c22-beta*f2*pg2+kappa*pk2)-2*rho*DeltaF

# Auxiliary outputs
aux f1=f1
aux f2=f2
aux bvar1=bvar1
aux bvar2=bvar2
aux csum1=csum1
aux csum2=csum2
aux DeltaM=(f1+bvar1+csum1)-(f2+bvar2+csum2)

par gamma=0.2,Ntot=40,beta=0.015,kappa=0.08,rho=0.13,theta=0.1

