dc214/dt=theta*((beta*13^gamma*f2*c213-kappa*14*c214)-(beta*14^gamma*f2*c214-kappa*15*c215))
dc215/dt=theta*((beta*14^gamma*f2*c214-kappa*15*c215)-(beta*15^gamma*f2*c215-kappa*16*c216))
dc216/dt=theta*((beta*15^gamma*f2*c215-kappa*16*c216)-(beta*16^gamma*f2*c216-kappa*17*c217))
dc217/dt=theta*((beta*16^gamma*f2*c216-kappa*17*c217)-(beta*17^gamma*f2*c217-kappa*18*c218))
dc218/dt=theta*((beta*17^gamma*f2*c217-kappa*18*c218)-(beta*18^gamma*f2*c218-kappa*19*c219))
