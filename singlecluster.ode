# asymmetry.ode
# Asymmetry ODE system
# Variables: N, F, Ft
# Lambda1 and Lambda2 inlined into ODEs

# ODEs
db1/dt = beta*f1*(f1+b1^gamma)-kappa*b1
df1/dt = -beta*f1*(f1+b1^gamma)+kappa*b1+rho*(f2-f1)
db2/dt = beta*f2*(f2+b2^gamma)-kappa*b2
df2/dt = -beta*f2*(f2+b2^gamma)+kappa*b2+rho*(f1-f2)

# Parameters 
par gamma=0.2, beta=0.015,kappa=0.08,rho=0.13

# Initial conditions
init f1=1 b1=19 b2=19 f2=1

# Numerics / main window
@ total=5000,dt=0.1
@ xlo=0,xhi=500,ylo=0,yhi=50

# AUTO window settings
@ autoxmin=-0.5,autoxmax=3,autoymin=-60,autoymax=60
@ parmin=0,parmax=3
@ nmax=500,ds=0.01,dsmin=0.005,dsmax=0.1

done
